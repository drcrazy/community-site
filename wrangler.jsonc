{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-site",
  "compatibility_date": "2026-10-01",
  "main": "./src/worker.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-site",
      "database_id": "cd5c4dbf-0cf1-488c-ae16-0763f816a097",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BENBEN",
        "class_name": "BenbenDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-benben",
      "new_classes": ["BenbenDurableObject"]
    }
  ]
}
