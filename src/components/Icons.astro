---
interface Props {
  name:
    | "brand"
    | "home"
    | "news"
    | "benben"
    | "guilds"
    | "events"
    | "guides"
    | "calculators"
    | "simulations"
    | "inbox"
    | "globe"
    | "sun"
    | "moon"
    | "menu"
    | "github";
  class?: string;
}

const { name, class: className = "icon" } = Astro.props;
const base = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  "aria-hidden": "true" as const,
  focusable: "false" as const,
  class: className,
};
---

{
  name === "brand" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="9" r="4.2" fill="currentColor" opacity=".95"></circle>
      <path
        d="M3 16.4c1.8 0 1.8 1.5 3.6 1.5s1.8-1.5 3.6-1.5 1.8 1.5 3.6 1.5 1.8-1.5 3.6-1.5 1.8 1.5 3.6 1.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        opacity=".75"></path>
      <path
        d="M3 20c1.8 0 1.8 1.5 3.6 1.5s1.8-1.5 3.6-1.5 1.8 1.5 3.6 1.5 1.8-1.5 3.6-1.5 1.8 1.5 3.6 1.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        opacity=".4"></path>
    </svg>
  )
}
{
  name === "home" && (
    <svg {...base}>
      <path d="M4 10.5 12 4l8 6.5"></path>
      <path d="M6 9.8V20h12V9.8"></path>
      <path d="M10 20v-5h4v5"></path>
    </svg>
  )
}
{
  name === "news" && (
    <svg {...base}>
      <path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6"></path>
      <path d="M6 4a2 2 0 0 0-2 2v1h2"></path>
      <path d="M6 20a2 2 0 0 0 2-2V6"></path>
      <path d="M11 9h5M11 13h5M11 17h3"></path>
    </svg>
  )
}
{
  name === "benben" && (
    <svg {...base}>
      <path d="m3.5 20 8.5-16 8.5 16z"></path>
      <path d="M6.2 15h11.6M8.8 10h6.4M11 6h2"></path>
      <path d="M2.5 21h19"></path>
    </svg>
  )
}
{
  name === "guilds" && (
    <svg {...base}>
      <path d="M4 19V10.5L12 5l8 5.5V19"></path>
      <path d="M9.5 19v-4.2a2.5 2.5 0 0 1 5 0V19"></path>
      <circle cx="8" cy="12.2" r="1.35"></circle>
      <circle cx="16" cy="12.2" r="1.35"></circle>
      <circle cx="12" cy="11.2" r="1.45"></circle>
    </svg>
  )
}
{
  name === "events" && (
    <svg {...base}>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"></rect>
      <path d="M3.5 10h17M8 3.5V6M16 3.5V6"></path>
      <rect x="7" y="13" width="3.4" height="3.2" rx=".7" fill="currentColor" stroke="none"></rect>
    </svg>
  )
}
{
  name === "guides" && (
    <svg {...base}>
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v17H6.5A2.5 2.5 0 0 0 4 22z"></path>
      <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v17h4.5a2.5 2.5 0 0 1 2.5 2z"></path>
      <path d="M12 3v17"></path>
    </svg>
  )
}
{
  name === "calculators" && (
    <svg {...base}>
      <rect x="4" y="3" width="16" height="18" rx="2.5"></rect>
      <path d="M8 7.5h8"></path>
      <path d="M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01" stroke-width="2.2"></path>
    </svg>
  )
}
{
  name === "simulations" && (
    <svg {...base}>
      <rect x="3" y="3" width="18" height="18" rx="2.5"></rect>
      <path d="M9 3v18M15 3v18M3 9h18M3 15h18" opacity=".65"></path>
      <rect x="9" y="9" width="6" height="6" fill="currentColor" stroke="none" opacity=".55"></rect>
    </svg>
  )
}
{
  name === "inbox" && (
    <svg {...base}>
      <path d="M4 8.5 6.2 4h11.6L20 8.5v9.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"></path>
      <path d="M4 9.5h4.2a2.8 2.8 0 0 0 5.6 0H20"></path>
    </svg>
  )
}
{
  name === "globe" && (
    <svg {...base}>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3.5 9.5h17M3.5 14.5h17"></path>
      <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path>
    </svg>
  )
}
{
  name === "sun" && (
    <svg {...base}>
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
    </svg>
  )
}
{
  name === "moon" && (
    <svg {...base}>
      <path d="M20 13.5A8 8 0 0 1 10.5 4a8 8 0 1 0 9.5 9.5z"></path>
    </svg>
  )
}
{
  name === "menu" && (
    <svg {...base}>
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  )
}
{
  name === "github" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
      <path
        d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1-1.4-1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.6s.8-.3 2.8 1a9.5 9.5 0 0 1 5 0c2-1.3 2.8-1 2.8-1a3.6 3.6 0 0 1 .1 2.6 3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
      ></path>
    </svg>
  )
}
