---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AppShell from "../../../components/AppShell.astro";
import { BenbenPage } from "../../../components/benben/BenbenPage";
import { benbenLabels } from "../../../components/benben/labels";
import { isLocale, localizedPath, type Locale } from "../../../lib/i18n/locales";
import { ui } from "../../../lib/i18n/ui";

export const prerender = false;

const langParam = Astro.params.lang ?? "";
if (!isLocale(langParam)) return Astro.redirect("/en/benben/");
const lang = langParam as Locale;
const t = ui(lang, Astro.locals.uiOverrides);
const copy = benbenLabels(lang);
const signedIn = Boolean(Astro.locals.member);
---

<BaseLayout title={`${copy.title} · Pop Epoch Guides`} description={copy.lede} locale={lang}>
  <AppShell locale={lang} activeSection="benben" pageBackground="general" crumbs={[{ label: t.overview, href: localizedPath(lang, "/") }, { label: copy.title }]}>
    <header class="page-head">
      <div class="eyebrow">{copy.greeting}</div>
      <h1>{copy.title}</h1>
      <p>{copy.lede}</p>
    </header>
    <BenbenPage
      client:load
      locale={lang}
      signedIn={signedIn}
      signInHref={localizedPath(lang, "/sign-in/")}
      memberId={Astro.locals.member?.id ?? null}
    />
  </AppShell>
</BaseLayout>
